// PhotoAnnotator 主窗口（第二阶段：图片显示）
// 完整布局见 doc/设计规范.md：菜单栏 + 工作目录侧边栏 + 标注画布 + 状态栏
export component AppWindow inherits Window {
    title: "PhotoAnnotator";
    preferred-width: 1000px;
    preferred-height: 700px;
    background: #F8F9FA;

    // 状态栏文字
    in-out property <string> status: "启动中...";
    // 当前显示的图片（Rust 端设置）
    in property <image> current-image;

    VerticalLayout {
        // 画布区域：占据剩余空间，图片等比缩放适应容器
        Rectangle {
            vertical-stretch: 1;
            background: #FFFFFF;
            border-radius: 6px;
            border-width: 1px;
            border-color: #E0E0E0;
            clip: true;

            Image {
                source: root.current-image;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }
        }

        // 状态栏
        HorizontalLayout {
            Rectangle {
                height: 32px;
                background: #FFFFFF;
                border-radius: 6px;
                border-width: 1px;
                border-color: #E0E0E0;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: root.status;
                        font-size: 12px;
                        color: #757575;
                    }
                }
            }
        }
    }
}
