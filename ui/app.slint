// PhotoAnnotator 主窗口（第二阶段：图片加载 + 视图交互 + 矩形标注）
// 预览矩形用原生元素实时显示（拖动流畅），完成后并入标注层位图
import { Button, ListView } from "std-widgets.slint";

/// 单行文字输入组件：FocusScope + 内建 TextInput（支持中文 IME）
/// 相比 std LineEdit 可通过 forward-focus 编程聚焦（显示即输入，无需二次点击）
component InlineTextInput inherits FocusScope {
    in-out property <string> text <=> input.text;
    callback accepted <=> input.accepted;
    width: 260px;
    height: 32px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #FFFFFF;
        border-radius: 6px;
        border-width: 1px;
        border-color: #4A90D9;

        input := TextInput {
            x: 6px;
            width: parent.width - 12px;
            height: 100%;
            vertical-alignment: center;
            color: #212121;
            font-size: 14px;
            single-line: true;
        }
    }
    // FocusScope 获得焦点时转发给内部 TextInput
    forward-focus: input;
}

/// 文字标注的显示项（图片坐标；随视图变换缩放）
export struct TextDisplay {
    x: float,
    y: float,
    text: string,
    font-size: float,
}

/// 工作目录文件列表项（列表/网格共用；网格占位项 kind=-1）
export struct FileEntry {
    path: string,
    name: string,
    // 类型：0=图片 1=子目录 -1=网格行空占位
    kind: int,
    // 状态：0=未处理 1=已标注 2=已忽略（图片）
    status: int,
    // 缩略图（Rust 端解码为 Slint Image）
    thumb: image,
}

/// 网格视图行：固定 3 格（不足用 kind=-1 占位）
export struct GridRow {
    c0: FileEntry,
    c1: FileEntry,
    c2: FileEntry,
}

/// 最近工作区列表项
export struct RecentEntry {
    name: string,
    path: string,
}

/// 侧边栏小按钮（视图切换 / 最近）
component SideBtn {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    min-width: 30px;
    height: 18px;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 4px;
        background: root.active ? #4A90D9 : transparent;
        border-width: 1px;
        border-color: root.active ? #4A90D9 : #BDBDBD;
        Text {
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.label;
            font-size: 10px;
            color: root.active ? #FFFFFF : #757575;
        }
        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

/// 网格视图单元格（行内等分；kind=-1 为空占位不可交互；悬停 Tooltip 显示完整文件名）
component GridCell {
    in property <FileEntry> entry;
    in property <int> gidx;
    in property <int> current-row: -1;
    callback clicked;
    callback rename-clicked;
    // 行内三等分（父为行内 HorizontalLayout）
    horizontal-stretch: 1;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 4px;
        background: root.entry.kind == -1 ? transparent
            : root.gidx == root.current-row ? #E3EDF8
            : root.entry.kind == 1 ? #EFF4FB : transparent;
        TouchArea {
            enabled: root.entry.kind >= 0;
            clicked => { root.clicked(); }
            // 右键格 = 重命名
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.rename-clicked();
                }
            }
        }
        // Tooltip 须声明在 TouchArea 之后（顶层）才能收到 hover；TooltipArea 不消费事件，点击穿透到 TouchArea
        if root.entry.kind >= 0: Tooltip {
            Rectangle {
                background: #FFFFFF;
                border-radius: 4px;
                border-width: 1px;
                border-color: #E0E0E0;
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    Text {
                        text: root.entry.name;
                        font-size: 11px;
                        color: #212121;
                    }
                }
            }
        }
        VerticalLayout {
            width: 100%;
            height: 100%;
            alignment: center;
            spacing: 2px;
            padding-left: 4px;
            padding-right: 4px;
            // 缩略图 / 目录图标位（占位格透明空位；kind 互斥，用独立 if）
            if root.entry.kind == 0: Image {
                width: 44px;
                height: 30px;
                source: root.entry.thumb;
                image-fit: contain;
            }
            if root.entry.kind == 1: Rectangle {
                width: 44px;
                height: 30px;
                background: #D6E6F8;
                border-radius: 4px;
                Text {
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "▸";
                    font-size: 16px;
                    color: #4A90D9;
                }
            }
            if root.entry.kind == -1: Rectangle {
                width: 44px;
                height: 30px;
            }
            // 名称（fill 行宽；超长 elide，完整名见 Tooltip）
            Text {
                width: 100%;
                text: root.entry.name;
                font-size: 10px;
                color: root.entry.kind == 1 ? #4A90D9 : #212121;
                overflow: elide;
                horizontal-alignment: center;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "PhotoAnnotator";
    preferred-width: 1000px;
    preferred-height: 700px;
    background: #F8F9FA;

    // ---- 状态（Rust 端读写）----
    in-out property <string> status: "启动中...";
    in property <image> current-image;
    in property <image> overlay-image; // 标注层（已完成的图元，透明位图）
    // 图片原始像素尺寸
    in-out property <length> image-width: 0px;
    in-out property <length> image-height: 0px;
    // 手动模式（自由）变换值
    in-out property <float> view-scale: 1.0;
    in-out property <length> view-offset-x: 0px;
    in-out property <length> view-offset-y: 0px;
    // true=自适应模式；false=自由模式
    in-out property <bool> fit-mode: true;
    // 当前工具：-1=指针态(默认/切图后；左键拖动平移) 0=矩形 1=椭圆 2=箭头 3=画笔 4=文字
    // 标注工具下平移 = 中键/右键拖动；退出工具 = 再点当前按钮 / Esc
    in-out property <int> active-tool: -1;
    // 极简模式：隐藏工具条/侧边栏/状态栏，仅画布 + 全键盘操作（Ctrl+M 切换）
    in-out property <bool> minimal-mode: false;
    // 极简模式提示条可见（进入极简/切图时点亮，3 秒后 Rust 熄灭）
    in-out property <bool> minimal-tip-visible: true;
    // 提示条文本（进入极简/极简下切图的序号反馈）
    in-out property <string> minimal-tip: "极简模式 · Ctrl+M 退出 · Esc 取消/退出 · ←/→ 切图";

    // ---- 绘制中预览 ----
    // 矩形预览（原生 Rectangle，拖动流畅）
    in-out property <bool> preview-visible: false;
    in-out property <length> preview-x: 0px;
    in-out property <length> preview-y: 0px;
    in-out property <length> preview-w: 0px;
    in-out property <length> preview-h: 0px;
    // 椭圆/箭头预览（共用 Path + SVG commands，图片坐标由 Rust 生成）
    in-out property <bool> preview-path-visible: false;
    in-out property <string> preview-commands: "";
    // Path 填充色：椭圆=transparent（仅描边），箭头=红（三角实心）
    in-out property <brush> preview-fill: transparent;
    // Path 描边宽度（viewbox 单位=图片像素）：椭圆 3px，箭头 5px
    in-out property <length> preview-stroke-width: 3px;
    // ---- 文字标注显示（Slint 原生 Text，随视图缩放）----
    in-out property <[TextDisplay]> text-annotations: [];
    // 文字输入框（画布坐标定位；Enter 提交）
    in-out property <bool> text-input-visible: false;
    in-out property <length> text-input-x: 0px;
    in-out property <length> text-input-y: 0px;
    in-out property <string> text-draft: "";

    // ---- 自动适配计算（fit 模式实时跟随视口）----
    property <float> fit-scale: min(min(root.viewport-width / max(root.image-width, 1px), root.viewport-height / max(root.image-height, 1px)), 1.0);
    property <length> fit-x: (root.viewport-width - root.image-width * root.fit-scale) * 0.5;
    property <length> fit-y: (root.viewport-height - root.image-height * root.fit-scale) * 0.5;

    // ---- 当前生效的显示变换（fit 与 free 的统一抽象）----
    property <float> disp-scale: root.fit-mode ? root.fit-scale : root.view-scale;
    property <length> disp-x: root.fit-mode ? root.fit-x : root.view-offset-x;
    property <length> disp-y: root.fit-mode ? root.fit-y : root.view-offset-y;

    // ---- 工作目录（第三阶段）----
    in-out property <string> workspace-title: "未打开工作目录";
    in-out property <[FileEntry]> file-list: [];
    // 网格视图行模型（列表/网格共用同一数据源，Rust 端同步维护）
    in-out property <[GridRow]> grid-rows: [];
    // 视图：0=列表 1=网格
    in-out property <int> view-mode: 0;
    // 当前选中条目行号（列表=行号，网格=全局条目序号；-1 = 无）
    in-out property <int> current-row: -1;
    // 当前图片索引（图片在 files 中的位置；-1 = 无）
    in-out property <int> current-index: -1;
    // 列表点击项索引（属性传值，规避带参 callback 解析问题）
    in-out property <int> clicked-file: -1;
    callback select-file;
    // 面包屑：各级目录显示名（可点击导航）
    in-out property <[string]> crumb-list: [];
    in-out property <int> clicked-crumb: -1;
    callback crumb-clicked;
    // 最近工作区（面板 overlay）
    in-out property <bool> recent-visible: false;
    in-out property <[RecentEntry]> recent-list: [];
    in-out property <int> clicked-recent: -1;
    callback recent-selected;
    // 「最近」按钮：Rust 端拉取列表并切换面板显隐
    callback open-recent;
    // 「打开」按钮：系统对话框选择工作目录（Windows 原生 SHBrowseForFolder）
    callback open-folder;
    // 排序：点击循环 名称↑ → 名称↓ → 时间↑ → 时间↓（Rust 记模式并重排当前目录）
    in-out property <string> sort-label: "名↑";
    callback sort-toggle;
    // 列表/网格视图切换（Rust 持久化偏好）
    callback view-changed;
    // 侧边栏信息（图/目录计数）
    in-out property <string> sidebar-meta: "";
    // 切图加载中（画布中央浮层）
    in-out property <bool> loading: false;

    // ---- 回调（Rust 端响应，无参；坐标经 pointer-x/y 属性传递）----
    callback zoom-in;
    callback zoom-out;
    callback reset-view;
    callback tool-changed;
    callback undo;
    callback save;
    callback copy;
    // Esc：优先取消当前绘制，无绘制且极简模式时退出极简模式
    callback escape-pressed;
    // Ctrl+M：极简模式切换（Rust 控制提示条点亮/熄灭）
    callback toggle-minimal;
    // 文字输入确认（Enter）
    callback text-commit;
    in-out property <length> pointer-x: 0px;
    in-out property <length> pointer-y: 0px;
    // 按下按键：0=左 1=中 2=右（pointer-event down 时写入；中/右键=平移）
    in-out property <int> pointer-button: 0;
    callback pointer-down;
    callback pointer-move;
    callback pointer-up;
    // ←/→：切换上一张/下一张图片（极简模式下浏览工作目录图片）
    callback prev-image;
    callback next-image;
    // 重命名图片文件：右键条目发起 → 浮层输入新名（Enter/确定确认，Esc/取消放弃）
    in-out property <bool> rename-visible: false;
    in-out property <string> rename-title: "重命名图片";
    in-out property <string> rename-draft: "";
    in-out property <int> clicked-rename-file: -1;
    callback rename-row;
    callback rename-confirm;
    callback rename-cancel;

    VerticalLayout {
        // ---- 工具条（极简模式：if 条件渲染——hidden 元素仍占布局，须彻底移除）----
        if !root.minimal-mode: HorizontalLayout {
            height: 36px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            Button {
                text: "矩形";
                checked: root.active-tool == 0;
                clicked => {
                    root.active-tool = root.active-tool == 0 ? -1 : 0;
                    root.tool-changed();
                    canvas-fs.focus();
                }
            }
            Button {
                text: "椭圆";
                checked: root.active-tool == 1;
                clicked => {
                    root.active-tool = root.active-tool == 1 ? -1 : 1;
                    root.tool-changed();
                    canvas-fs.focus();
                }
            }
            Button {
                text: "箭头";
                checked: root.active-tool == 2;
                clicked => {
                    root.active-tool = root.active-tool == 2 ? -1 : 2;
                    root.tool-changed();
                    canvas-fs.focus();
                }
            }
            Button {
                text: "画笔";
                checked: root.active-tool == 3;
                clicked => {
                    root.active-tool = root.active-tool == 3 ? -1 : 3;
                    root.tool-changed();
                    canvas-fs.focus();
                }
            }
            Button {
                text: "文字";
                checked: root.active-tool == 4;
                clicked => {
                    root.active-tool = root.active-tool == 4 ? -1 : 4;
                    root.tool-changed();
                    canvas-fs.focus();
                }
            }
            Button {
                text: "马赛克";
                checked: root.active-tool == 5;
                clicked => {
                    root.active-tool = root.active-tool == 5 ? -1 : 5;
                    root.tool-changed();
                    canvas-fs.focus();
                }
            }
            Rectangle { width: 8px; }
            Button {
                text: "撤销";
                clicked => { root.undo(); canvas-fs.focus(); }
            }
            Rectangle { width: 8px; }
            Button {
                text: "保存";
                clicked => { root.save(); canvas-fs.focus(); }
            }
            Button {
                text: "复制";
                clicked => { root.copy(); canvas-fs.focus(); }
            }
            Rectangle { width: 8px; }
            Button {
                text: "重置";
                clicked => { root.reset-view(); canvas-fs.focus(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                vertical-alignment: center;
                text: "中键/右键拖动 = 平移 · 滚轮 = 缩放";
                font-size: 11px;
                color: #9E9E9E;
            }
        }

        // ---- 主体：工作目录侧边栏 + 画布 ----
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 8px;

            // ---- 工作目录侧边栏（极简模式：if 条件渲染，画布才可扩展占满）----
            if !root.minimal-mode: workspace-side := Rectangle {
                width: 236px;
                background: #FFFFFF;
                border-radius: 6px;
                border-width: 1px;
                border-color: #E0E0E0;
                clip: true;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    // 行1：目录标题 + 计数 + 最近按钮
                    HorizontalLayout {
                        height: 20px;
                        spacing: 6px;
                        Text {
                            text: root.workspace-title;
                            font-size: 12px;
                            font-weight: 600;
                            color: #212121;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.sidebar-meta;
                            font-size: 10px;
                            color: #757575;
                            vertical-alignment: center;
                        }
                        SideBtn {
                            label: "打开";
                            active: false;
                            clicked => { root.open-folder(); }
                        }
                        SideBtn {
                            label: "最近";
                            active: root.recent-visible;
                            clicked => { root.open-recent(); }
                        }
                    }
                    // 行2：面包屑（可点击导航）+ 列表/网格切换
                    HorizontalLayout {
                        height: 20px;
                        spacing: 4px;
                        // 面包屑（仅多于一级时显示；末级为当前目录）
                        HorizontalLayout {
                            visible: root.crumb-list.length > 1;
                            horizontal-stretch: 1;
                            for crumb[idx] in root.crumb-list: HorizontalLayout {
                                Rectangle {
                                    height: 18px;
                                    TouchArea {
                                        clicked => {
                                            root.clicked-crumb = idx;
                                            root.recent-visible = false;
                                            root.crumb-clicked();
                                            canvas-fs.focus();
                                        }
                                    }
                                    VerticalLayout {
                                        width: 100%;
                                        height: 100%;
                                        alignment: center;
                                        Text {
                                            text: crumb;
                                            font-size: 11px;
                                            color: idx == root.crumb-list.length - 1 ? #212121 : #4A90D9;
                                            font-weight: idx == root.crumb-list.length - 1 ? 600 : 400;
                                        }
                                    }
                                }
                                if idx < root.crumb-list.length - 1: Text {
                                    height: 18px;
                                    vertical-alignment: center;
                                    text: "/";
                                    font-size: 11px;
                                    color: #BDBDBD;
                                }
                            }
                        }
                        Rectangle { width: 4px; }
                        // 排序模式（循环切换：名称/时间 × 升/降）
                        SideBtn {
                            label: root.sort-label;
                            active: false;
                            clicked => {
                                root.sort-toggle();
                                canvas-fs.focus();
                            }
                        }
                        SideBtn {
                            label: "列表";
                            active: root.view-mode == 0;
                            clicked => {
                                root.view-mode = 0;
                                root.view-changed();
                                root.recent-visible = false;
                                canvas-fs.focus();
                            }
                        }
                        SideBtn {
                            label: "网格";
                            active: root.view-mode == 1;
                            clicked => {
                                root.view-mode = 1;
                                root.view-changed();
                                root.recent-visible = false;
                                canvas-fs.focus();
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: #E0E0E0;
                    }

                    // ---- 视图内容区（if 条件实例化：false 分支完全不占布局空间，
                    //      避免 visible 切换时隐藏 ListView 仍按隐式高度占位把内容推到底部）----
                    // 列表视图（虚拟化；单击图=切图，双击目录=进入）
                    if root.view-mode == 0: ListView {
                        vertical-stretch: 1;
                        for entry[idx] in root.file-list: Rectangle {
                            height: 46px;
                            border-radius: 4px;
                            background: idx == root.current-row ? #E3EDF8 : transparent;
                            TouchArea {
                                clicked => {
                                    root.clicked-file = idx;
                                    root.select-file();
                                    canvas-fs.focus();
                                }
                                // 右键图片行 = 重命名（打开浮层并聚焦输入框）
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                        root.clicked-rename-file = idx;
                                        root.rename-row();
                                        rename-scope.focus();
                                    }
                                }
                                // 内容垂直居中（行高 46）
                                VerticalLayout {
                                    width: 100%;
                                    height: 100%;
                                    alignment: center;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        // 子目录前缀符号（无缩略图）
                                        if entry.kind == 1: Text {
                                            width: 14px;
                                            text: "▸";
                                            font-size: 13px;
                                            color: #4A90D9;
                                        }
                                        // 图片缩略图
                                        if entry.kind == 0: Image {
                                            width: 40px;
                                            height: 30px;
                                            source: entry.thumb;
                                            image-fit: contain;
                                        }
                                        // 名称（目录蓝色）
                                        Text {
                                            height: 100%;
                                            vertical-alignment: center;
                                            text: entry.name;
                                            font-size: 12px;
                                            color: entry.kind == 1 ? #4A90D9 : #212121;
                                            overflow: elide;
                                        }
                                        // 状态点（0 未处理灰 / 1 已标注蓝 / 2 已忽略浅灰；仅图片）
                                        Rectangle {
                                            visible: entry.kind == 0;
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: entry.status == 1 ? #4A90D9 : entry.status == 2 ? #BDBDBD : #9E9E9E;
                                        }
                                    }
                                }
                            }
                        // Tooltip 声明在 TouchArea 之后（顶层收 hover；TooltipArea 不消费事件，点击穿透到 TouchArea）
                        Tooltip {
                            Rectangle {
                                background: #FFFFFF;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #E0E0E0;
                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    Text {
                                        text: entry.name;
                                        font-size: 11px;
                                        color: #212121;
                                    }
                                }
                            }
                        }
                        }
                    }

                    // 网格视图（ListView 行 = 3 格；虚拟化滚动）
                    if root.view-mode == 1: ListView {
                        vertical-stretch: 1;
                        for row[ri] in root.grid-rows: Rectangle {
                            height: 72px;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 6px;
                                GridCell { entry: row.c0; gidx: ri * 3 + 0; current-row: root.current-row; clicked => { root.clicked-file = self.gidx; root.select-file(); canvas-fs.focus(); } rename-clicked => { root.clicked-rename-file = self.gidx; root.rename-row(); rename-scope.focus(); } }
                                GridCell { entry: row.c1; gidx: ri * 3 + 1; current-row: root.current-row; clicked => { root.clicked-file = self.gidx; root.select-file(); canvas-fs.focus(); } rename-clicked => { root.clicked-rename-file = self.gidx; root.rename-row(); rename-scope.focus(); } }
                                GridCell { entry: row.c2; gidx: ri * 3 + 2; current-row: root.current-row; clicked => { root.clicked-file = self.gidx; root.select-file(); canvas-fs.focus(); } rename-clicked => { root.clicked-rename-file = self.gidx; root.rename-row(); rename-scope.focus(); } }
                            }
                        }
                    }
                }

                // 最近工作区浮层面板（绝对定位盖在列表区上；声明在布局后 → z 序在上层）
                recent-panel := Rectangle {
                    visible: root.recent-visible;
                    x: 3px;
                    y: 58px;
                    width: workspace-side.width - 6px;
                    height: min(root.recent-list.length * 34px + 46px, workspace-side.height - 66px);
                    background: #FFFFFF;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #4A90D9;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        Text {
                            text: "最近工作区";
                            font-size: 11px;
                            font-weight: 600;
                            color: #212121;
                        }
                        if root.recent-list.length == 0: Text {
                            text: "（暂无最近工作区）";
                            font-size: 11px;
                            color: #9E9E9E;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for r[idx] in root.recent-list: Rectangle {
                                height: 32px;
                                border-radius: 4px;
                                TouchArea {
                                    clicked => {
                                        root.clicked-recent = idx;
                                        root.recent-selected();
                                        canvas-fs.focus();
                                    }
                                    VerticalLayout {
                                        width: 100%;
                                        height: 100%;
                                        alignment: center;
                                        HorizontalLayout {
                                            width: 100%;
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            spacing: 6px;
                                            Text {
                                                text: r.name;
                                                font-size: 12px;
                                                color: #212121;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: r.path;
                                                font-size: 10px;
                                                color: #9E9E9E;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ---- 画布区域：原图 + 标注层 + 预览 + 手势 ----
            canvas-area := Rectangle {
                horizontal-stretch: 1;
                background: #FFFFFF;
                border-radius: 6px;
                border-width: 1px;
                border-color: #E0E0E0;
                clip: true;

            // 画布交互层：FocusScope 捕获键盘（点击画布后生效）
            canvas-fs := FocusScope {
                // ---- 键盘快捷键（@keys 字面量；输入文字时禁用，避免劫持按键）----
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("1"); activated => { root.active-tool = 0; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("2"); activated => { root.active-tool = 1; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("3"); activated => { root.active-tool = 2; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("4"); activated => { root.active-tool = 3; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("5"); activated => { root.active-tool = 4; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("6"); activated => { root.active-tool = 5; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("r"); activated => { root.active-tool = 0; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("o"); activated => { root.active-tool = 1; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("a"); activated => { root.active-tool = 2; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("p"); activated => { root.active-tool = 3; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("t"); activated => { root.active-tool = 4; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys("m"); activated => { root.active-tool = 5; root.tool-changed(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys(Control+Z); activated => { root.undo(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys(Control+C); activated => { root.copy(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys(Control+S); activated => { root.save(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys(Control+M); activated => { root.toggle-minimal(); } }
                // ←/→ 切图（文字输入时不劫持光标移动）
                KeyBinding { enabled: !root.text-input-visible; keys: @keys(LeftArrow); activated => { root.prev-image(); } }
                KeyBinding { enabled: !root.text-input-visible; keys: @keys(RightArrow); activated => { root.next-image(); } }
                // Esc 保持可用：取消文字输入/绘制/退出极简
                KeyBinding { keys: @keys(Escape); activated => { root.escape-pressed(); } }

                // 原图层
                Image {
                    source: root.current-image;
                    x: root.disp-x;
                    y: root.disp-y;
                    width: root.image-width * root.disp-scale;
                    height: root.image-height * root.disp-scale;
                    image-fit: fill;
                }
                // 标注层（已完成的图元）
                Image {
                    source: root.overlay-image;
                    x: root.disp-x;
                    y: root.disp-y;
                    width: root.image-width * root.disp-scale;
                    height: root.image-height * root.disp-scale;
                    image-fit: fill;
                }
                // 绘制中预览矩形（原生元素，拖动实时跟随；线宽 3px 与标注层一致，随缩放）
                Rectangle {
                    visible: root.preview-visible;
                    x: root.disp-x + root.preview-x * root.disp-scale;
                    y: root.disp-y + root.preview-y * root.disp-scale;
                    width: root.preview-w * root.disp-scale;
                    height: root.preview-h * root.disp-scale;
                    border-width: 3px * root.disp-scale;
                    border-color: #F44336;
                }
                // 绘制中预览（椭圆描边 / 箭头线段+实心三角；viewbox=整图，坐标即图片像素）
                Path {
                    visible: root.preview-path-visible;
                    x: root.disp-x;
                    y: root.disp-y;
                    width: root.image-width * root.disp-scale;
                    height: root.image-height * root.disp-scale;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: root.image-width / 1px;
                    viewbox-height: root.image-height / 1px;
                    commands: root.preview-commands;
                    stroke: #F44336;
                    stroke-width: root.preview-stroke-width;
                    fill: root.preview-fill;
                }

                // 文字标注显示（随视图缩放；item 坐标单位为图片像素）
                for item in root.text-annotations: Text {
                    x: root.disp-x + item.x * 1px * root.disp-scale;
                    y: root.disp-y + item.y * 1px * root.disp-scale;
                    text: item.text;
                    font-size: item.font-size * 1px * root.disp-scale;
                    color: #F44336;
                }

                // 手势层
                touch := TouchArea {
                    scroll-event(event) => {
                        root.pointer-x = touch.mouse_x;
                        root.pointer-y = touch.mouse_y;
                        if event.delta_y > 0 {
                            root.zoom-in();
                        } else if event.delta_y < 0 {
                            root.zoom-out();
                        }
                        return EventResult.accept;
                    }
                    // 左键 = 当前工具操作（绘制/文字落点）；中键/右键 = 平移（任意工具）
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left {
                            if event.kind == PointerEventKind.down {
                                root.pointer-button = 0;
                                canvas-fs.focus(); // 点击画布 → 键盘焦点交给快捷键层
                                root.pointer-x = touch.mouse_x;
                                root.pointer-y = touch.mouse_y;
                                root.pointer-down();
                                // 文字工具落点：输入框显示后立即聚焦（forward 到 TextInput，可直接打字/IME）
                                if root.active-tool == 4 {
                                    inline-text.focus();
                                }
                            } else if event.kind == PointerEventKind.up {
                                root.pointer-x = touch.mouse_x;
                                root.pointer-y = touch.mouse_y;
                                root.pointer-up();
                            }
                        } else if event.button == PointerEventButton.middle {
                            if event.kind == PointerEventKind.down {
                                root.pointer-button = 1;
                                canvas-fs.focus();
                                root.pointer-x = touch.mouse_x;
                                root.pointer-y = touch.mouse_y;
                                root.pointer-down();
                            } else if event.kind == PointerEventKind.up {
                                root.pointer-x = touch.mouse_x;
                                root.pointer-y = touch.mouse_y;
                                root.pointer-up();
                            }
                        } else if event.button == PointerEventButton.right {
                            if event.kind == PointerEventKind.down {
                                root.pointer-button = 2;
                                canvas-fs.focus();
                                root.pointer-x = touch.mouse_x;
                                root.pointer-y = touch.mouse_y;
                                root.pointer-down();
                            } else if event.kind == PointerEventKind.up {
                                root.pointer-x = touch.mouse_x;
                                root.pointer-y = touch.mouse_y;
                                root.pointer-up();
                            }
                        }
                    }
                    moved => {
                        root.pointer-x = touch.mouse_x;
                        root.pointer-y = touch.mouse_y;
                        root.pointer-move();
                    }
                }

                // 文字输入框（浮于画布；点击落点后自动聚焦，Enter 确认提交）
                inline-text := InlineTextInput {
                    visible: root.text-input-visible;
                    x: root.text-input-x;
                    y: root.text-input-y;
                    text <=> root.text-draft;
                    accepted => { root.text-commit(); }
                }
            }

            // 极简模式提示条（画布左下角，半透明浮层；进入极简后 3 秒自动消失）
            Rectangle {
                visible: root.minimal-mode && root.minimal-tip-visible;
                x: 14px;
                y: canvas-area.height - 42px;
                width: 400px;
                height: 28px;
                background: rgba(255, 255, 255, 0.85);
                border-radius: 6px;
                border-width: 1px;
                border-color: #E0E0E0;
                Text {
                    x: 12px;
                    vertical-alignment: center;
                    width: 380px;
                    height: 100%;
                    text: root.minimal-tip;
                    font-size: 12px;
                    color: #757575;
                }
            }

            // 切图加载中浮层（画布中央，半透明深底白字）
            Rectangle {
                visible: root.loading;
                x: (canvas-area.width - 150px) / 2;
                y: (canvas-area.height - 40px) / 2;
                width: 150px;
                height: 40px;
                background: rgba(33, 33, 33, 0.72);
                border-radius: 8px;
                Text {
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "加载中…";
                    font-size: 14px;
                    color: #FFFFFF;
                }
            }
        }
        } // <- canvas-area 包裹的 HorizontalLayout 闭合

        // ---- 状态栏（极简模式：if 条件渲染，不残留底部占位）----
        if !root.minimal-mode: HorizontalLayout {
            Rectangle {
                height: 32px;
                background: #FFFFFF;
                border-radius: 6px;
                border-width: 1px;
                border-color: #E0E0E0;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Text {
                        text: root.status;
                        font-size: 12px;
                        color: #757575;
                    }
                }
            }
        }
    }

    // ---- 重命名图片浮层（声明在布局后 → 顶层；Enter/确定确认，Esc/取消关闭）----
    rename-dialog := Rectangle {
        visible: root.rename-visible;
        x: (root.width - 340px) / 2;
        y: (root.height - 140px) / 2;
        width: 340px;
        height: 132px;
        background: #FFFFFF;
        border-radius: 8px;
        border-width: 1px;
        border-color: #4A90D9;
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            Text {
                text: root.rename-title;
                font-size: 13px;
                font-weight: 600;
                color: #212121;
            }
            // 输入焦点作用域：forward 到输入框；Esc 取消（不依赖画布快捷键层）
            rename-scope := FocusScope {
                forward-focus: rename-input;
                KeyBinding { keys: @keys(Escape); activated => { root.rename-cancel(); canvas-fs.focus(); } }
                rename-input := InlineTextInput {
                    text <=> root.rename-draft;
                    accepted => { root.rename-confirm(); canvas-fs.focus(); }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: "确定";
                    clicked => { root.rename-confirm(); canvas-fs.focus(); }
                }
                Button {
                    text: "取消";
                    clicked => { root.rename-cancel(); canvas-fs.focus(); }
                }
            }
        }
    }

    // 视口尺寸同步（alias 到 canvas-area）
    in-out property <length> viewport-width <=> canvas-area.width;
    in-out property <length> viewport-height <=> canvas-area.height;
}
